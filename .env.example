# Optional local overrides. Docker Compose has course-demo defaults, so this
# file is not required for `docker compose up --build`.
DB_NAME=biblicom
DB_USER=biblicom_app
DB_PASSWORD=biblicom_course_db
DB_ROOT_PASSWORD=biblicom_course_root
DB_PORT=3306

BIBLICOM_ADMIN_BOOTSTRAP_ENABLED=true
BIBLICOM_ADMIN_EMAIL=admin@biblicom.local
BIBLICOM_ADMIN_PASSWORD=Biblicom-Curso-2026!

WEB_PORT=3000
SESSION_COOKIE_SECURE=false
